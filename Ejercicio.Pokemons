using System;

namespace ConsoleApp6
{
    internal class Program
    {
        public struct Pokemon
        {
            
            public string nombre { get; set; }
            public int nivel { get; set; }
            public int ps { get; set; }
            public int ataque { get; set; }
            public int defensa { get; set; }
            public int ae { get; set; }
            public int de { get; set; }
            public int velocidad { get; set; }
            public string estado { get; set; }

           
            public Pokemon(string nombre, int nivel, int ps, int ataque, int defensa, int ae, int de, int velocidad, string estado)
            {
                this.nombre = nombre;
                this.nivel = nivel;
                this.ps = ps;
                this.ataque = ataque;
                this.defensa = defensa;
                this.ae = ae;
                this.de = de;
                this.velocidad = velocidad;
                this.estado = estado;
            }
        }

        public struct Entrenador
        {
            
            public string nombre { get; set; }
            public int pokedolares { get; set; }
            public string[] medallas { get; set; }
            public Pokemon[] equipo { get; set; }

            
            public Entrenador(string nombre, int pokedolares, string[] medallas, Pokemon[] equipo)
            {
                this.nombre = nombre;
                this.pokedolares = pokedolares;
                this.medallas = medallas;
                this.equipo = equipo;
            }

            //funciones
            public int damenivel()
            {
                int retorno = 0;
                for (int i = 0; i <= 5; i++)
                {
                    retorno = retorno + equipo[i].nivel;
                }
                return retorno;
            }

            // Cuenta cuantos Pokemon tienen un estado diferente a normal
            public int ContarPokemonesConEstadoAlterado()
            {
                int contador = 0;
                for (int i = 0; i < equipo.Length; i++)
                {
                    if (equipo[i].estado != "Normal")
                    {
                        contador++;
                    }
                }
                return contador;
            }
        }

        // Funcion para comprar una pocion, usa ref porque Entrenador es un struct
        static void ComprarPocion(ref Entrenador entrenador)
        {
            if (entrenador.pokedolares >= 200)
            {
                entrenador.pokedolares -= 200;
                Console.WriteLine($"{entrenador.nombre} compro una pocion.{entrenador.pokedolares} pokedolares restantes.");
            }
            else
            {
                Console.WriteLine($"{entrenador.nombre} no se pudo comprar");
            }
        }

        // Funcion que compara medallas de dos entrenadores
        static Entrenador CompararMedallas(Entrenador e1, Entrenador e2)
        {
            if (e1.medallas.Length >= e2.medallas.Length)
            {
                return e1;
            }
            return e2;
        }

        // Funcion que devuelve al entrenador con mas Pokemon con estado alterado
        static Entrenador MasPokemonesAlterados(Entrenador e1, Entrenador e2)
        {
            if (e1.ContarPokemonesConEstadoAlterado() >= e2.ContarPokemonesConEstadoAlterado())
            {
                return e1;
            }
            return e2;
        }

        static void Main(string[] args)
        {
            // lista de pokemons
            Pokemon[] equipo1 = new Pokemon[]
            {
                new Pokemon("Pikachu", 50, 150, 90, 55, 110, 50, 90, "Normal"),
                new Pokemon("Charizard", 55, 180, 84, 78, 109, 85, 100, "Envenenado"),
                new Pokemon("Blastoise", 52, 175, 83, 100, 85, 105, 78, "Normal"),
                new Pokemon("Venusaur", 51, 170, 82, 83, 100, 100, 80, "Paralizado"),
                new Pokemon("Snorlax", 48, 160, 110, 65, 55, 55, 45, "Normal"),
                new Pokemon("Gengar", 50, 130, 65, 60, 130, 110, 110, "Normal")
            };

            // otra lista de pokemons
            Pokemon[] equipo2 = new Pokemon[]
             {
                new Pokemon("Dragonite", 52, 160, 134, 95, 70, 100, 80, "Normal"),
                new Pokemon("Alakazam", 50, 140, 50, 70, 135, 115, 120, "Dormido"),
                new Pokemon("Gyarados", 49, 200, 130, 60, 95, 85, 65, "Normal"),
                new Pokemon("Rhydon", 53, 155, 110, 96, 83, 85, 45, "Normal"),
                new Pokemon("Jolteon", 50, 135, 110, 100, 50, 70, 130, "Normal"),
                new Pokemon("Starmie", 51, 145, 105, 75, 100, 90, 115, "Normal")
             };

            string[] medallas1 = new string[] { "Medalla Roca", "Medalla Cascada", "Medalla Trueno" };
            string[] medallas2 = new string[] { "Medalla Roca", "Medalla Cascada" };

            Entrenador entrenador1 = new Entrenador("Ash", 500, medallas1, equipo1);
            Entrenador entrenador2 = new Entrenador("Pepe", 100, medallas2, equipo2);

            //  Comprar Pocion

            ComprarPocion(ref entrenador1);
            ComprarPocion(ref entrenador2);
            Console.WriteLine();

            //  Comparar Medallas

            Entrenador conMasMedallas = CompararMedallas(entrenador1, entrenador2);
            Console.WriteLine($"El entrenador con mas medallas es: {conMasMedallas.nombre}");
            Console.WriteLine();

            //  Mayor cantidad de pokemones con estado alterado 

            Entrenador conMasAlterados = MasPokemonesAlterados(entrenador1, entrenador2);
            Console.WriteLine($"El entrenador con mas pokemones con estado alterado es: {conMasAlterados.nombre}");
            Console.WriteLine();

            // Comparacion nivel

            if (entrenador1.damenivel() > entrenador2.damenivel())
            {
                Console.WriteLine(entrenador1.nombre + " Tiene mas nivel que: " + entrenador2.nombre);
            }
            else if (entrenador2.damenivel() > entrenador1.damenivel())
            {
                Console.WriteLine(entrenador2.nombre + " Tiene mas nivel que: " + entrenador1.nombre);
            }
            else
            {
                Console.WriteLine("Tienen el mismo nivel");
            }
        }
    }
}