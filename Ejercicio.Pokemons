using System;

namespace ConsoleApp7
{
    internal class Program
    {

        public struct Pokemon
        {
            public string Nombre { get; set; }
            public int Nivel { get; set; }
            public int Ps { get; set; } // PS Máximos
            public int PsActuales { get; set; } // PS Actuales
            public int Ataque { get; set; }
            public int Defensa { get; set; }
            public int Ae { get; set; } // Ataque Especial
            public int De { get; set; } // Defensa Especial
            public int Velocidad { get; set; }
            public string Estado { get; set; }

            // Estadística calculada: Peligrosidad
            public double Peligrosidad => (Ataque + Ae + Velocidad) / 3.0;

            public Pokemon(string nombre, int nivel, int ps, int ataque, int defensa, int ae, int de, int velocidad, string estado)
            {
                Nombre = nombre;
                Nivel = nivel;
                Ps = ps;
                PsActuales = ps;
                Ataque = ataque;
                Defensa = defensa;
                Ae = ae;
                De = de;
                Velocidad = velocidad;
                Estado = estado;
            }

            public void CambiarEstado(string nuevoEstado)
            {
                if (Estado == "Normal" || string.IsNullOrEmpty(Estado))
                {
                    Estado = nuevoEstado;
                    Console.WriteLine($"{Nombre}, {PsActuales} esta {Estado}");
                }
                else
                {
                    string estadoAnterior = Estado;
                    Estado = nuevoEstado;
                    Console.WriteLine($"{Nombre}, {PsActuales} paso de estar {estadoAnterior} a {Estado}");
                }
            }
        }

        public struct Entrenador
        {
            public string Nombre { get; set; }
            public int Pokedolares { get; set; }
            public string[] Medallas { get; set; }
            public Pokemon[] Equipo { get; set; }

            public Entrenador(string nombre, int pokedolares, string[] medallas, Pokemon[] equipo)
            {
                Nombre = nombre;
                Pokedolares = pokedolares;
                Medallas = medallas;
                Equipo = equipo;
            }

            public int DameNivelTotal()
            {
                int suma = 0;
                for (int i = 0; i < Equipo.Length; i++)
                {
                    suma += Equipo[i].Nivel;
                }
                return suma;
            }

            // Nivel máximo que puede controlar según medallas
            public int NivelMaximoControlable()
            {
                int limite = 20 + (Medallas.Length * 10);
                return Math.Min(limite, 99);
            }

            // Cuenta pokémones en estado alterado
            public int ContarEstadosAlterados()
            {
                int contador = 0;
                for (int i = 0; i < Equipo.Length; i++)
                {
                    if (Equipo[i].Estado != "Normal")
                    {
                        contador++;
                    }
                }
                return contador;
            }
        }


        // FUNCIONES



        // Menú para aplicar estado alterado a un pokémon específico
        public static void AplicarEfectoAlteradoMenu(ref Pokemon pokemon)
        {
            string[] efectos = { "Paralizado", "Quemado", "Envenenado", "Gravemente envenenado", "Dormido", "Congelado", "Normal" };

            Console.WriteLine($"\n--- Selecciona el estado para {pokemon.Nombre} ---");
            for (int i = 0; i < efectos.Length; i++)
            {
                Console.WriteLine($"{i + 1}. {efectos[i]}");
            }

            int opcion = 0;
            do
            {
                Console.Write("Opción: ");
                opcion = Convert.ToInt32(Console.ReadLine());
            } while (opcion < 1 || opcion > efectos.Length);

            pokemon.CambiarEstado(efectos[opcion - 1]);
        }

        // Determinar si un pokémon individual puede ser controlado
        public static bool PuedeControlarPokemon(Entrenador entrenador, Pokemon pokemon)
        {
            return pokemon.Nivel <= entrenador.NivelMaximoControlable();
        }

        // Determinar cuál entrenador tiene más pokémones que NO puede controlar
        public static void EntrenadorConMasIncontrolables(Entrenador e1, Entrenador e2)
        {
            int incontrolables1 = 0;
            int incontrolables2 = 0;

            for (int i = 0; i < e1.Equipo.Length; i++)
            {
                if (!PuedeControlarPokemon(e1, e1.Equipo[i]))
                {
                    incontrolables1++;
                }
            }

            for (int i = 0; i < e2.Equipo.Length; i++)
            {
                if (!PuedeControlarPokemon(e2, e2.Equipo[i]))
                {
                    incontrolables2++;
                }
            }

            if (incontrolables1 > incontrolables2)
            {
                Console.WriteLine($"{e1.Nombre} tiene mas pokemones que no puede controlar ({incontrolables1}).");
            }
            else if (incontrolables2 > incontrolables1)
            {
                Console.WriteLine($"{e2.Nombre} tiene mas pokemones que no puede controlar ({incontrolables2}).");
            }
            else
            {
                Console.WriteLine("Ambos entrenadores tienen la misma cantidad de pokemones incontrolables.");
            }
        }

        // Comparar nivel total
        public static void comparar_nivel(Entrenador e1, Entrenador e2)
        {
            int nivel1 = e1.DameNivelTotal();
            int nivel2 = e2.DameNivelTotal();

            if (nivel1 > nivel2)
            {
                Console.WriteLine($"{e1.Nombre} suma mas nivel total ({nivel1} vs {nivel2}).");
            }
            else if (nivel2 > nivel1)
            {
                Console.WriteLine($"{e2.Nombre} suma mas nivel total ({nivel2} vs {nivel1}).");
            }
            else
            {
                Console.WriteLine($"Ambos entrenadores empatan con {nivel1} de nivel total.");
            }
        }

        // Comprar Poción 
        public static void ComprarPocion(ref Entrenador entrenador)
        {
            int precioPocion = 200;

            if (entrenador.Pokedolares >= precioPocion)
            {
                entrenador.Pokedolares -= precioPocion;
                Console.WriteLine($"{entrenador.Nombre} compró una poción. Le quedan ${entrenador.Pokedolares} Pokédolares.");
            }
            else
            {
                Console.WriteLine("no de pudo comprar");
            }
        }

        // Comparar Medallas
        public static void CompararMedallas(Entrenador e1, Entrenador e2)
        {
            int m1 = e1.Medallas.Length;
            int m2 = e2.Medallas.Length;

            if (m1 > m2)
            {
                Console.WriteLine($"{e1.Nombre} tiene mas medallas ({m1}) que {e2.Nombre} ({m2}).");
            }
            else if (m2 > m1)
            {
                Console.WriteLine($"{e2.Nombre} tiene mas medallas ({m2}) que {e1.Nombre} ({m1}).");
            }
            else
            {
                Console.WriteLine($"Ambos entrenadores tienen la misma cantidad de medallas ({m1}).");
            }
        }

        // Entrenador con más estados alterados
        public static void EntrenadorConMasAlterados(Entrenador e1, Entrenador e2)
        {
            int alt1 = e1.ContarEstadosAlterados();
            int alt2 = e2.ContarEstadosAlterados();

            if (alt1 > alt2)
            {
                Console.WriteLine($"{e1.Nombre} tiene mas pokemones con estado alterado ({alt1}).");
            }
            else if (alt2 > alt1)
            {
                Console.WriteLine($"{e2.Nombre} tiene mas pokemones con estado alterado ({alt2}).");
            }
            else
            {
                Console.WriteLine($"Ambos entrenadores tienen la misma cantidad de pokemones alterados ({alt1}).");
            }
        }

        // Entrenador con más pokémones con Peligrosidad > 60
        public static void EntrenadorMasPeligroso(Entrenador e1, Entrenador e2)
        {
            int p1 = 0;
            int p2 = 0;

            for (int i = 0; i < e1.Equipo.Length; i++)
            {
                if (e1.Equipo[i].Peligrosidad > 60)
                {
                    p1++;
                }
            }

            for (int i = 0; i < e2.Equipo.Length; i++)
            {
                if (e2.Equipo[i].Peligrosidad > 60)
                {
                    p2++;
                }
            }

            if (p1 > p2)
            {
                Console.WriteLine($"{e1.Nombre} tiene mas pokemones peligrosos (>60): {p1}.");
            }
            else if (p2 > p1)
            {
                Console.WriteLine($"{e2.Nombre} tiene mas pokemones peligrosos (>60): {p2}.");
            }
            else
            {
                Console.WriteLine($"Ambos entrenadores tienen {p1} pokemones con peligrosidad mayor a 60.");
            }
        }

        // Curar equipo completo
        public static void curarEquipo(ref Entrenador entrenador)
        {
            for (int i = 0; i < entrenador.Equipo.Length; i++)
            {
                entrenador.Equipo[i].PsActuales = entrenador.Equipo[i].Ps;
                entrenador.Equipo[i].Estado = "Normal";
            }
            Console.WriteLine($"¡El equipo de {entrenador.Nombre} ha sido completamente curado!");
        }

        //  Turno individual de batalla
        public static void EjecutarTurno(string nombreEntrenador, ref Pokemon atacante, ref Pokemon defensor)
        {
            Console.WriteLine($"\nTurno de {nombreEntrenador} con {atacante.Nombre} (PS: {atacante.PsActuales}/{atacante.Ps})");
            Console.WriteLine("1. Ataque Fisico");
            Console.WriteLine("2. Ataque Especial");

            int eleccion = 0;
            do
            {
                Console.Write("Selecciona el ataque: ");
                eleccion = Convert.ToInt32(Console.ReadLine());
            } while (eleccion != 1 && eleccion != 2);

            double danoBase = (eleccion == 1) ? atacante.Ataque : atacante.Ae;
            double defensaPorcentaje = (eleccion == 1) ? defensor.Defensa : defensor.De;

            double porcentajeResidual = Math.Max(0, (100.0 - defensaPorcentaje) / 100.0);
            int danoFinal = (int)(danoBase * porcentajeResidual);

            if (danoFinal < 1)
            {
                danoFinal = 1;
            }

            defensor.PsActuales = Math.Max(0, defensor.PsActuales - danoFinal);

            Console.WriteLine($"{atacante.Nombre} ataco a {defensor.Nombre} causando {danoFinal} de daño");
            Console.WriteLine($"PS de {defensor.Nombre}: {defensor.PsActuales}/{defensor.Ps}");
        }

        //  Sistema de Batalla
        public static void BatallaPokemon(Entrenador e1, Entrenador e2)
        {
            Console.WriteLine($"COMIENZA LA BATALLA: {e1.Nombre} VS {e2.Nombre}!");

            int idx1 = 0;
            int idx2 = 0;

            while (idx1 < e1.Equipo.Length && idx2 < e2.Equipo.Length)
            {
                ref Pokemon p1 = ref e1.Equipo[idx1];
                ref Pokemon p2 = ref e2.Equipo[idx2];

                Console.WriteLine($"COMBATE: {p1.Nombre} (de {e1.Nombre}) VS {p2.Nombre} (de {e2.Nombre}) ");

                while (p1.PsActuales > 0 && p2.PsActuales > 0)
                {
                    bool ganaE1Velocidad = p1.Velocidad >= p2.Velocidad;

                    if (ganaE1Velocidad)
                    {
                        EjecutarTurno(e1.Nombre, ref p1, ref p2);
                        if (p2.PsActuales <= 0) break;

                        EjecutarTurno(e2.Nombre, ref p2, ref p1);
                    }
                    else
                    {
                        EjecutarTurno(e2.Nombre, ref p2, ref p1);
                        if (p1.PsActuales <= 0) break;

                        EjecutarTurno(e1.Nombre, ref p1, ref p2);
                    }
                }

                if (p1.PsActuales <= 0)
                {
                    Console.WriteLine($"{p1.Nombre} se ha debilitado");
                    idx1++;
                }

                if (p2.PsActuales <= 0)
                {
                    Console.WriteLine($"{p2.Nombre} se ha debilitado");
                    idx2++;
                }
            }


            if (idx1 < e1.Equipo.Length)
            {
                Console.WriteLine($"¡EL GANADOR DE LA BATALLA ES {e1.Nombre.ToUpper()}!");
            }
            else
            {
                Console.WriteLine($"¡EL GANADOR DE LA BATALLA ES {e2.Nombre.ToUpper()}!");
            }
        }

        // MAIN

        public static void Main(string[] args)
        {
            Pokemon[] equipo1 = new Pokemon[]
            {
                new Pokemon("Pikachu", 25, 150, 90, 20, 110, 15, 90, "Normal"),
                new Pokemon("Charizard", 55, 180, 84, 30, 109, 25, 100, "Normal"),
                new Pokemon("Blastoise", 52, 175, 83, 40, 85, 35, 78, "Normal")
            };

            Pokemon[] equipo2 = new Pokemon[]
            {
                new Pokemon("Dragonite", 52, 160, 134, 25, 70, 20, 80, "Normal"),
                new Pokemon("Alakazam", 50, 140, 50, 15, 135, 30, 120, "Normal"),
                new Pokemon("Gyarados", 49, 200, 130, 35, 95, 25, 65, "Normal")
            };

            string[] medallasAsh = { "Medalla Roca", "Medalla Cascada" };
            string[] medallasPepe = { "Medalla Roca", "Medalla Cascada", "Medalla Trueno", "Medalla Volcan" };

            Entrenador entrenador1 = new Entrenador("Ash", 500, medallasAsh, equipo1);
            Entrenador entrenador2 = new Entrenador("Pepe", 100, medallasPepe, equipo2);

            // Pruebas
            Console.WriteLine("CAMBIAR ESTADO ");
            AplicarEfectoAlteradoMenu(ref entrenador1.Equipo[0]);

            Console.WriteLine(" CONTROL DE POKEMONES ");
            EntrenadorConMasIncontrolables(entrenador1, entrenador2);

            Console.WriteLine(" NIVEL TOTAL ");
            comparar_nivel(entrenador1, entrenador2);

            Console.WriteLine(" COMPRAR POCION ");
            ComprarPocion(ref entrenador1);
            ComprarPocion(ref entrenador2);

            Console.WriteLine(" COMPARAR MEDALLAS ");
            CompararMedallas(entrenador1, entrenador2);

            Console.WriteLine(" PELIGROSIDAD ");
            EntrenadorMasPeligroso(entrenador1, entrenador2);

            Console.WriteLine(" CURAR EQUIPO ");
            curarEquipo(ref entrenador1);

            Console.WriteLine(" BATALLA POKEMON ");
            BatallaPokemon(entrenador1, entrenador2);
        }
    }
}

